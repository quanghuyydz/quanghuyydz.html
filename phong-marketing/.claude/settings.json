{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(python3 cong-cu/*)",
      "Bash(python cong-cu/*)",
      "Bash(ls *)",
      "Bash(dir *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(del /s *)"
    ]
  }
}